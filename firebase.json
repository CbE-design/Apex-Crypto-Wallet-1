{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": [
      {
        "collectionGroup": "transactions",
        "queryScope": "COLLECTION_GROUP",
        "fields": [
          {
            "fieldPath": "userId",
            "order": "ASCENDING"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
