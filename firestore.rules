rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@apexwallet.io' ||
        request.auth.token.email == 'corrie@apex-crypto.co.uk' ||
        request.auth.token.email == 'apex@test.com' ||
        request.auth.uid == 'xTqwKRdxUnQnsNe4n7bQAHmh3lC3'
      );
    }

    // ─── Protocol Settings ─────────────────────────────────────────────────────
    match /protocol_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Core App Data ─────────────────────────────────────────────────────────

    match /withdrawal_requests/{requestId} {
      allow list:   if isAdmin() || isSignedIn();
      allow get:    if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /kyc_submissions/{submissionId} {
      allow list:   if isAdmin();
      allow get:    if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow read:   if isAdmin();
      allow write:  if isAdmin();
      // Users may create their own notifications (e.g. NEW_USER on registration)
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ─── Collection-group rules ────────────────────────────────────────────────
    // Admins can search wallets across all users (Fund Wallet page).
    // Owners can always read/write their own wallets via the specific /users/{userId} path below.
    match /{path=**}/wallets/{walletId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── User Profiles ────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any signed-in user may list with a filter (needed for wallet-address lookup
      // during import — the server-side API now handles this, but keep the rule
      // so the client-side fallback also works if needed).
      allow list:  if isAdmin() || isSignedIn();
      allow get:   if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Wallet sub-documents — owners and admins have full access.
      match /wallets/{walletId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Platform & Static Data ───────────────────────────────────────────────

    match /platform_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /prices/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Email / Notification Logs ────────────────────────────────────────────
    match /email_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /notification_logs/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Whale Treasury ───────────────────────────────────────────────────────
    match /whale_treasury/{docId} {
      allow read, write: if isAdmin();
    }

    match /whale_treasury_log/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
