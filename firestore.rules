rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@apexwallet.io' ||
        request.auth.token.email == 'corrie@apex-crypto.co.uk' ||
        request.auth.token.email == 'apex@test.com' ||
        request.auth.uid == 'xTqwKRdxUnQnsNe4n7bQAHmh3lC3'
      );
    }

    // ─── Protocol Settings ─────────────────────────────────────────────────────
    match /protocol_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Core App Data ─────────────────────────────────────────────────────────

    match /withdrawal_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    match /processed_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    match /kyc_submissions/{submissionId} {
      allow list:   if isAdmin();
      allow get:    if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow read:   if isAdmin();
      allow write:  if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /send_requests/{sendId} {
        allow read, write: if isAdmin();
    }

    match /internal_transfers/{transferId} {
        allow read, write: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /global_stats/{statId} {
      allow read, write: if isAdmin();
    }

    // ─── Collection-group rules ────────────────────────────────────────────────
    match /{path=**}/wallets/{walletId} {
      allow read, write: if isAdmin();
    }

    match /{path=**}/transactions/{transactionId} {
      allow read, write: if isAdmin();
    }

    // ─── User Profiles ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow list:  if isAdmin() || isSignedIn();
      allow get:   if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Wallets subcollection: Users can access their own wallets, admins can access any.
      match /wallets/{assetSymbol} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Transactions subcollection: Users can access their own transactions, admins can access any.
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Notifications subcollection for user-specific notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Platform & Static Data ───────────────────────────────────────────────

    match /platform_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /prices/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Email / Notification Logs ────────────────────────────────────────────
    match /email_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /notification_logs/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Whale Treasury ───────────────────────────────────────────────────────
    match /whale_treasury/{docId} {
      allow read, write: if isAdmin();
    }

    match /whale_treasury_log/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
