rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /notifications/{notificationId} {
      // READ: Allow reading if the doc has a userId and it matches the requester's UID.
      // This prevents queries from failing if a malformed doc without a userId exists.
      allow read: if 'userId' in resource.data && request.auth.uid == resource.data.userId;

      // UPDATE/DELETE: Same logic as read.
      allow update, delete: if 'userId' in resource.data && request.auth.uid == resource.data.userId;

      // CREATE: A user must be logged in. The new document MUST have a `userId` field,
      // and that field MUST match the UID of the user creating it.
      // This prevents users from creating notifications for other users from the client.
      allow create: if request.auth.uid != null
                    && 'userId' in request.resource.data
                    && request.resource.data.userId == request.auth.uid;
    }

    match /broadcasts/{broadcastId} {
      // Any authenticated user can read broadcasts.
      allow read: if request.auth.uid != null;

      // No user can write to the broadcasts collection. (Admin-only)
      allow write: if false;
    }

    // Rule for the user's subcollection of deleted broadcast IDs
    match /users/{userId}/deletedBroadcasts/{broadcastId} {
      // A user can only access (read, create, update, delete) their own list.
      allow read, write: if request.auth.uid == userId;
    }
  }
}
