rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@apexwallet.io' ||
        request.auth.token.email == 'corrie@apex-crypto.co.uk' ||
        request.auth.token.email == 'apex@test.com' ||
        request.auth.uid == 'xTqwKRdxUnQnsNe4n7bQAHmh3lC3'
      );
    }

    // ─── Protocol Settings ─────────────────────────────────────────────────────
    match /protocol_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Core App Data ─────────────────────────────────────────────────────────

    match /withdrawal_requests/{requestId} {
      allow list:   if isAdmin();
      allow get:    if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /kyc_submissions/{submissionId} {
      allow list:   if isAdmin();
      allow get:    if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow list, read, update, delete: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
    }

    // ─── Collection Group Rules ───────────────────────────────────────────────

    match /{path=**}/wallets/{walletId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Primary User & Wallet Rules ──────────────────────────────────────────

    match /users/{userId} {
      // This is the critical rule for the wallet import flow.
      // It allows a user to query the `users` collection, but ONLY if they are
      // querying by `walletAddress`. This prevents a user from listing all documents.
      // Firestore rules are not filters, so this rule ensures that the query itself
      // is permissible. The actual documents returned are still protected by `get` rules.
      allow list: if request.query.keys.hasAny(['walletAddress']);

      // A user can get their own document, or an admin can get any document.
      allow get:   if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      match /wallets/{walletId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Platform & Static Data ───────────────────────────────────────────────

    match /platform_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /prices/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /email_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /notification_logs/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
